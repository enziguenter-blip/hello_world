{
  "manifest_version": 3,
  "name": "Proto-Disput · Browserablauf",
  "version": "0.1.14",
  "description": "Lokale Testversion für schrittweise Dateiübergaben in einem ChatGPT-Chat.",
  "permissions": ["storage"],
  "host_permissions": ["https://chatgpt.com/*"],
  "content_scripts": [{
    "matches": ["https://chatgpt.com/*"],
    "js": ["workflow.js", "core.js", "adapter.js", "panel.js"],
    "run_at": "document_idle"
  }],
  "browser_specific_settings": {
    "gecko": {
      "id": "proto-disput-local@local.invalid",
      "strict_min_version": "128.0"
    }
  }
}
